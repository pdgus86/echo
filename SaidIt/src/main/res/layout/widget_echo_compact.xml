<?xml version="1.0" encoding="utf-8"?>
<!-- Echo home-screen widget. Buttons share the width equally and grow with the widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="6dp">

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:paddingBottom="4dp"
        android:text="@string/widget_status_stopped"
        android:textColor="@color/gray_c"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="32dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/widget_start"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_start"
            android:contentDescription="@string/widget_start_desc"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/widget_start_icon"
            android:textAllCaps="false"
            android:textColor="@color/gray_f"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_pause"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_pause"
            android:contentDescription="@string/widget_pause_desc"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/widget_pause_icon"
            android:textAllCaps="false"
            android:textColor="@color/gray_f"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_stop"
            android:contentDescription="@string/widget_stop_desc"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/widget_stop_icon"
            android:textAllCaps="false"
            android:textColor="@color/gray_f"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_save"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_save"
            android:contentDescription="@string/widget_save_desc"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/widget_save_icon"
            android:textAllCaps="false"
            android:textColor="@color/gray_f"
            android:textSize="16sp" />

        <Button
            android:id="@+id/widget_delete"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:background="@drawable/widget_button_delete"
            android:contentDescription="@string/widget_delete_desc"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="@string/widget_delete_icon"
            android:textAllCaps="false"
            android:textColor="@color/gray_f"
            android:textSize="16sp" />

    </LinearLayout>
</LinearLayout>
